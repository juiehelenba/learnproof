APP_NAME=LearnProof
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LEARNPROOF_NAME=LearnProof

# Tutor de IA (OpenAI) — Course → Context → Tutor
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_HISTORY=20
AI_TIMEOUT=30
AI_CONTEXT_CACHE_TTL=600
AI_LESSON_EXCERPT_CHARS=1200
# Estimativa de custo no painel de metricas (USD por 1M tokens).
AI_PRICE_PROMPT_PER_1M=0.15
AI_PRICE_COMPLETION_PER_1M=0.60

# Blockchain EVM — Polygon Amoy (testnet)
# 1) Crie conta em https://alchemy.com ou https://infura.io (RPC grátis)
# 2) Carteira com MATIC testnet: https://faucet.polygon.technology/
# 3) cd blockchain && npm install
# 4) Configure RPC + chave privada abaixo e rode: php artisan blockchain:setup --deploy
# 5) BLOCKCHAIN_MODE=evm e inicie a fila: php artisan queue:listen
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_WALLET_PRIVATE_KEY=
BLOCKCHAIN_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/%s
BLOCKCHAIN_TIMEOUT=120

# Cache da verificacao on-chain, em segundos. Evita que a pagina publica de
# verificacao dispare um processo Node a cada acesso. 0 desativa o cache.
BLOCKCHAIN_VERIFY_CACHE_TTL=300

# Tentativas do quiz por hora, por aluno. Impede descobrir as respostas
# corretas por forca bruta. 0 remove o limite.
QUIZ_MAX_ATTEMPTS_PER_HOUR=5

# Nota minima usada quando o quiz nao define a sua propria.
CERTIFICATE_MIN_SCORE=70
